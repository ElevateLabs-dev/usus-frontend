# Address of the Usus backend API (used by the Next.js proxy at /api/backend).
# Local backend:
BACKEND_URL=http://127.0.0.1:8000/api/v1
# Deployed backend:
# BACKEND_URL=https://usus-api-utc7.onrender.com/api/v1

# Vapi public key for voice role-play (Vapi dashboard → API Keys).
# Leave empty to offer text role-play only.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
